{
  "buildCommand": "pnpm run build",
  "devCommand": "pnpm run dev",
  "installCommand": "pnpm install",
  "framework": "vite",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "env": {
    "DATABASE_URL": "@database_url",
    "AUTH_SECRET": "@auth_secret",
    "GITHUB_ID": "@github_id",
    "GITHUB_SECRET": "@github_secret"
  },
  "regions": ["iad1"],
  "functions": {
    "api/**": {
      "maxDuration": 10
    }
  }
}
